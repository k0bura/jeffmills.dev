---
import Base from "../layouts/Base.astro";

const items = [
  {
    href: "/about",
    label: "About",
    note: "read more",
    summary:
      "20+ years, Philadelphia agencies then Vanguard. Hands-on technical lead. Now looking to build front ends for public services.",
  },
  {
    href: "/case-studies",
    label: "Case Studies",
    note: "the arc",
    summary:
      "Nine years at Vanguard FAS: bringing Vue into a legacy stack without a rewrite, one design system for 11 teams across three frameworks, governance at scale, a GenAI rollout gated on risk review, accessibility remediation to a WCAG 2.2 AA target, and the hands-on work of putting the system under real quality gates.",
  },
  {
    href: "/projects",
    label: "Projects",
    note: "5 projects",
    summary:
      "Meridian, Anchor, and Skeletor, twelve years of design-system architecture, with architectural overviews. Plus the Gen UI Claude tool-use pipeline and sych0net.",
  },
  {
    href: "/writing",
    label: "Writing",
    note: "9 posts",
    summary:
      "Production notes on design systems, generative UI, MCP, testing, telemetry, governance, and front-end architecture.",
  },
  {
    href: "/talks",
    label: "Talks",
    note: "2 talks",
    summary:
      "Internal Vanguard co-presentations: the CMS and design-system rebrand story, and Trust at Scale, digitizing Vanguard expertise with GenAI.",
  },
  {
    href: "/press",
    label: "Press",
    note: "8 outlets",
    summary:
      "Coverage of Expert Insights, the Vanguard FAS product I set the technical direction for, announced April 2026.",
  },
  {
    href: "mailto:jeffy9@gmail.com",
    label: "Contact",
    note: "email",
    summary: "Reach out about front-end work in civic tech and public services.",
  },
];
---

<Base title="Jeff Mills, Principal Front-End Engineer">
  <section class="hero">
    <h1>jeff mills</h1>
    <p class="role">Principal front-end engineer. Looking to build for public services.</p>
    <p class="bio">
      I'm Jeff Mills, a front-end engineer in the Philadelphia area. I've been doing this for 20+ years, first at Philadelphia agencies and then at Vanguard, and I look at everything through a UI lens. At Vanguard I built the design system that 11 teams build on, and I'm still in the code. Releases there go through compliance and accessibility review, which I came to like. I want to do that work for public services next.
    </p>
  </section>

  <hr class="jm-rule" />

  <ul class="nav-list">
    {
      items.map(({ href, label, note, summary }) => (
        <li>
          <a href={href} class="row">
            <span class="row-label">{label}</span>
            <span class="row-dots" aria-hidden="true" />
            <span class="row-note">{note}</span>
          </a>
          <p class="row-summary">{summary}</p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .hero h1 {
    font-size: 1.5rem;
    text-transform: lowercase;
    letter-spacing: 0.05em;
    margin: 0.5rem 0 0.75rem;
  }

  .role {
    margin: 0;
    color: var(--jm-color-fg);
  }

  .bio {
    margin: 0.5rem 0 0;
    color: var(--jm-color-muted);
  }

  .bio :global(strong) {
    color: var(--jm-color-fg);
    font-weight: 400;
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-list > li {
    margin: 1.25rem 0;
  }

  .row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--jm-color-link);
  }

  .row::before {
    content: ">";
    color: var(--jm-color-muted);
  }

  .row-label {
    color: var(--jm-color-fg);
  }

  .row:hover .row-label,
  .row:hover .row-note {
    color: var(--jm-color-accent);
  }

  .row-dots {
    flex: 1;
    border-bottom: 1px dotted var(--jm-color-border);
    transform: translateY(-0.3em);
    min-width: 1.5rem;
  }

  .row-note {
    color: var(--jm-color-ok);
    font-size: 0.9em;
  }

  .row-summary {
    margin: 0.25rem 0 0 1rem;
    color: var(--jm-color-muted);
    font-size: 0.9em;
  }
</style>
